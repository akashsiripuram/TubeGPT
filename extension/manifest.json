{
    "manifest_version": 3,

    "name": "TubeGPT",

    "version": "1.0.0",

    "description": "Ask questions about YouTube videos using RAG and Gemini.",

    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "sidePanel"
    ],

    "host_permissions": [
        "https://www.youtube.com/*",
        "http://127.0.0.1:8000/*"
    ],

    "action": {
        "default_title": "Open TubeGPT"
    },

    "side_panel": {
        "default_path": "sidepanel.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}